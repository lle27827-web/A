{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "migrate": "node ./scripts/migrations.mjs migrate",
    "migrate:audit": "node ./scripts/migrations.mjs audit",
    "migrate:baseline": "node ./scripts/migrations.mjs baseline",
    "test:migrations": "node --test ./scripts/migrations.test.mjs",
    "migrate:card-topups": "node ./scripts/apply-card-topups.mjs",
    "migrate:employee-history": "node ./scripts/apply-employee-history.mjs",
    "migrate:card-usage-lock": "node ./scripts/apply-card-usage-lock.mjs",
    "migrate:personal-notebook": "node ./scripts/apply-personal-notebook.mjs",
    "migrate:personal-sync": "node ./scripts/apply-personal-sync.mjs",
    "migrate:facility-permissions": "node ./scripts/apply-facility-permissions.mjs",
    "migrate:appointments": "node ./scripts/apply-appointments.mjs",
    "migrate:card-usage-history": "node ./scripts/apply-card-usage-history.mjs",
    "migrate:api-write-operations": "node ./scripts/apply-api-write-operations.mjs",
    "migrate:database-failover-state": "node ./scripts/apply-database-failover-state.mjs",
    "migrate:database-failover-state-to-db4": "node ./scripts/apply-database-failover-state-to-db4.mjs",
    "migrate:database-failover-coordinator": "node ./scripts/apply-database-failover-coordinator.mjs",
    "migrate:storage-partitioning": "node ./scripts/apply-storage-partitioning.mjs",
    "migrate:retention-range-indexes": "node ./scripts/apply-retention-range-indexes.mjs",
    "storage-compression:check": "node ./scripts/apply-storage-compression.mjs",
    "storage-compression:apply": "node ./scripts/apply-storage-compression.mjs --apply",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
