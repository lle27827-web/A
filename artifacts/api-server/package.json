{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:auth": "esbuild src/lib/owner-auth.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-auth-tests.cjs && node --test /tmp/so-cong-auth-tests.cjs",
    "test:permission-policy": "esbuild src/lib/facility-permissions-unit.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-permission-policy-tests.cjs && node --test /tmp/so-cong-permission-policy-tests.cjs",
    "test:retention": "esbuild src/lib/retention-*.test.ts --bundle --platform=node --format=cjs --outdir=/tmp/so-cong-retention-tests && node --test /tmp/so-cong-retention-tests/*.test.js",
    "test:retention-integration": "esbuild src/lib/retention.integration.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-retention-integration.cjs && node --test /tmp/so-cong-retention-integration.cjs",
    "test:permissions": "esbuild src/lib/facility-permissions.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-permission-tests.cjs && node --test /tmp/so-cong-permission-tests.cjs",
    "test:massage": "esbuild src/lib/massage.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/cung-lam-massage-tests.cjs && node --test /tmp/cung-lam-massage-tests.cjs",
    "test:massage-identity": "esbuild src/lib/massage-identity.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-massage-identity-tests.cjs && node --test /tmp/so-cong-massage-identity-tests.cjs",
    "test:customer-phone": "esbuild src/lib/customer-phone.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-customer-phone-tests.cjs && node --test /tmp/so-cong-customer-phone-tests.cjs",
    "test:partitioned-mutations": "esbuild src/lib/partitioned-mutations.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-partitioned-mutation-tests.cjs && node --test /tmp/so-cong-partitioned-mutation-tests.cjs",
    "test:attendance-policy": "esbuild src/lib/attendance-policy.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-attendance-policy-tests.cjs && node --test /tmp/so-cong-attendance-policy-tests.cjs",
    "test:attendance": "esbuild src/routes/attendance.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-attendance-tests.cjs && node --test /tmp/so-cong-attendance-tests.cjs",
    "test:access-grants": "esbuild src/routes/access-grants.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-access-grants-tests.cjs && node --test /tmp/so-cong-access-grants-tests.cjs",
    "test:reentrant-locks": "esbuild ../../lib/db/src/reentrant-advisory-lock.test.ts ../../lib/db/src/async-mutex.test.ts --bundle --platform=node --format=cjs --outdir=/tmp/so-cong-reentrant-lock-tests && node --test /tmp/so-cong-reentrant-lock-tests/*.js",
    "test:service-types": "esbuild src/routes/service-types.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-service-type-tests.cjs && node --test /tmp/so-cong-service-type-tests.cjs",
    "test:revenue": "esbuild src/lib/facility-revenue.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-revenue-tests.cjs && node --test /tmp/so-cong-revenue-tests.cjs",
    "test:card-topups": "esbuild src/lib/card-topups.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-card-topup-tests.cjs && node --test /tmp/so-cong-card-topup-tests.cjs",
    "test:employee-history": "esbuild src/lib/employee-history.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-employee-history-tests.cjs && node --test /tmp/so-cong-employee-history-tests.cjs",
    "test:personal": "esbuild src/lib/personal-notebook.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-personal-tests.cjs && node --test /tmp/so-cong-personal-tests.cjs",
    "test:personal-sync": "esbuild src/lib/personal-sync.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-personal-sync-tests.cjs && node --test /tmp/so-cong-personal-sync-tests.cjs",
    "test:card-merge": "esbuild src/lib/card-merge.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-card-merge-tests.cjs && node --test /tmp/so-cong-card-merge-tests.cjs",
    "test:appointments": "esbuild src/routes/appointments.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-appointments-tests.cjs && node --test /tmp/so-cong-appointments-tests.cjs",
    "test:database-failover": "esbuild src/lib/database-failover.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-database-failover-tests.cjs && node --test /tmp/so-cong-database-failover-tests.cjs",
    "test:failover-capacity-cache": "esbuild ../../lib/db/src/failover-capacity-cache.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-failover-capacity-cache-tests.cjs && node --test /tmp/so-cong-failover-capacity-cache-tests.cjs",
    "test:failover-recovery": "esbuild ../../lib/db/src/failover-recovery.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-failover-recovery-tests.cjs && node --test /tmp/so-cong-failover-recovery-tests.cjs",
    "test:storage-partitioning": "esbuild src/lib/storage-partitioning.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-storage-partitioning-tests.cjs && node --test /tmp/so-cong-storage-partitioning-tests.cjs",
    "test:partition-read-cache": "esbuild ../../lib/db/src/partition-read-cache.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-partition-read-cache-tests.cjs && node --test /tmp/so-cong-partition-read-cache-tests.cjs",
    "test:partitioned-revenue": "esbuild src/lib/facility-revenue.partitioned.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-partitioned-revenue-tests.cjs && node --test /tmp/so-cong-partitioned-revenue-tests.cjs",
    "test:write-rate-limit": "esbuild src/lib/write-rate-limit-key.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/so-cong-write-rate-limit-tests.cjs && node --test /tmp/so-cong-write-rate-limit-tests.cjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/express": "^2.1.78",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
