{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "installCommand": "pnpm install --frozen-lockfile --filter @workspace/api-server...",
      "buildCommand": "pnpm --filter @workspace/db run migrate:card-topups && pnpm --filter @workspace/db run migrate:employee-history && pnpm --filter @workspace/db run migrate:card-usage-lock && pnpm --filter @workspace/db run migrate:personal-notebook && pnpm -r --filter @workspace/api-server... --if-present run build"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile --filter @workspace/mockup-sandbox...",
      "buildCommand": "pnpm -r --filter @workspace/mockup-sandbox... --if-present run build",
      "outputDirectory": "dist"
    },
    "task-manager": {
      "root": "artifacts/task-manager",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile --filter @workspace/task-manager...",
      "buildCommand": "pnpm -r --filter @workspace/task-manager... --if-present run build",
      "outputDirectory": "dist/public",
      "routes": [
        {
          "src": "^/(?!api(?:/|$)|assets(?:/|$)|favicon\\.svg$|logo\\.svg$|robots\\.txt$|index\\.html$).*$",
          "methods": ["GET", "HEAD"],
          "dest": "/index.html",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "task-manager"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "task-manager"
      }
    },
    {
      "source": "/logo.svg",
      "destination": {
        "service": "task-manager"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "task-manager"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "task-manager"
      }
    }
  ]
}
